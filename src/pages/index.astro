---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/hero-packaging-desk.jpg';

const buyerQuestions = [
  'Which folding-carton converters could genuinely serve our launch — and who fits our volumes?',
  'Is there a glass supplier that meets our stated food-contact requirements and MOQ?',
  'What are the realistic corrugated options for an outer that survives export?',
];

const focusRows = [
  {
    num: '01',
    category: 'Folding cartons & paperboard',
    detail: 'Board grades and grammage, print capability, finishes and stated MOQs — as published.',
  },
  {
    num: '02',
    category: 'Corrugated & shipping',
    detail: 'RSC and die-cut cases, inserts and transit performance claims, board grades and stated capacities.',
  },
  {
    num: '03',
    category: 'Rigid boxes & carton gifting',
    detail: 'Construction, wrapping and finishing signals for rigid and set-up formats, as described publicly.',
  },
  {
    num: '04',
    category: 'Glass & rigid plastic',
    detail: 'Volumes, neck and closure finishes, material types and food-contact statements as published.',
  },
  {
    num: '05',
    category: 'Flexible films, pouches & lidding',
    detail: 'Stated structures, formats and barrier claims where public sources describe them.',
  },
  {
    num: '06',
    category: 'Labels & printed materials',
    detail: 'Self-adhesive labels, sleeves and inserts — print processes, decoration and MOQ signals.',
  },
];

const reportContents = [
  {
    num: '01',
    title: 'Requirements',
    text: 'The agreed packaging needs and research criteria, restated plainly — the shared basis the whole report is measured against.',
  },
  {
    num: '02',
    title: 'Potential suppliers',
    text: 'Businesses identified for further consideration — names, locations, public websites and contact routes, and why each connects to your criteria.',
  },
  {
    num: '03',
    title: 'Sources',
    text: 'The published material behind each finding — company pages, directories, filings — each recorded with the date it was reviewed.',
  },
  {
    num: '04',
    title: 'Gaps',
    text: 'Missing, unclear or unconfirmed information, marked as such. A visible gap is information — a confident guess is not.',
  },
  {
    num: '05',
    title: 'Recommended enquiries',
    text: 'Questions you could put to the potential suppliers, and what to listen for in the answers.',
  },
];

const criteriaRows = [
  {
    criterion: 'Food-contact suitability (as published)',
    state: 'published',
    stateLabel: 'Published',
    shows: 'Stated on the supplier’s own site; source and date recorded in the report.',
    next: 'Confirm in writing before any order.',
  },
  {
    criterion: 'Minimum order quantity',
    state: 'gap',
    stateLabel: 'Gap',
    shows: 'Not stated in any source reviewed — recorded as unconfirmed, not estimated.',
    next: 'Ask directly, or take them off the shortlist.',
  },
  {
    criterion: 'Lead time',
    state: 'conflict',
    stateLabel: 'Conflict',
    shows: 'A trade directory and the company site disagree — both figures cited with dates.',
    next: 'Ask the supplier to reconcile the two.',
  },
  {
    criterion: 'Export markets',
    state: 'published',
    stateLabel: 'Published',
    shows: 'Markets claimed in supplier literature; source and date recorded.',
    next: 'Check against your destination before shortlisting.',
  },
];

const processSteps = [
  {
    num: '01',
    title: 'Email the need',
    text: 'Tell us what you are sourcing — a few sentences are enough. Quantities, markets and timeframe help, but are optional.',
  },
  {
    num: '02',
    title: 'Clarify the brief',
    text: 'We ask follow-up questions and restate your criteria in writing. You confirm or correct — the research starts from your version, not ours.',
  },
  {
    num: '03',
    title: 'Feasibility view',
    text: 'Before any fee, we say whether public information is likely to answer your question — plainly, including when the answer is no.',
  },
  {
    num: '04',
    title: 'Scope and quotation',
    text: 'A fixed-fee, individually tailored quotation — scope, deliverables and timeline in writing. Nothing starts before you approve it.',
  },
  {
    num: '05',
    title: 'Research',
    text: 'Desk research across public commercial sources. Sources and research dates recorded as we go; gaps marked, not filled in.',
  },
  {
    num: '06',
    title: 'Delivery and follow-up',
    text: 'You receive the report, then a walkthrough of concerns, gaps and recommended enquiries. Follow-on research is quoted separately.',
  },
];

---

<BaseLayout
  title="International Procurement Intelligence | Obsidixz Commercial"
  description="Packaging sourcing questions, answered with structured research — requirements, potential suppliers, sources, gaps and recommended enquiries in one fixed-fee report."
  path="/"
>
  {/* 1 — Photographic hero (preserved) */}
  <section class="hero on-dark" aria-labelledby="hero-heading">
    <div class="wrap hero__grid">
      <div class="hero__body">
        <p class="eyebrow">Packaging &amp; Supplier Research</p>
        <h1 id="hero-heading">International Procurement Intelligence.</h1>
        <p class="lede">
          Obsidixz Commercial helps businesses identify potential suppliers, assess
          available commercial information and make better-informed procurement
          decisions through structured supplier research and sourcing intelligence.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/contact">Discuss your research needs</a>
          <a class="btn btn--outline-dark" href="/services">Explore Services</a>
        </div>
        <p class="hero__note">
          Fixed-fee, individually tailored quotations. Packaging is our initial
          industry focus.
        </p>
      </div>
      <div class="hero__media">
        <Image
          src={heroImage}
          alt="Carefully arranged packaging materials on a dark work surface — corrugated board, paperboard cartons, glass containers, material swatches and sample chips"
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1024px) 52vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* 2 — Q1: What sourcing question do I need answered? */}
  <section class="section" aria-labelledby="question-heading">
    <div class="wrap">
      <div class="lede-row">
        <div>
          <p class="eyebrow">Your starting point</p>
          <h2 id="question-heading">Every project starts with a question you cannot answer from your&nbsp;desk.</h2>
        </div>
        <div>
          <p class="lede">
            That question — asked properly, answered with evidence — is the whole
            service. Supplier Discovery turns it into a written brief, researches it
            across public commercial information and delivers the findings as a
            dated, sourced report you can interrogate.
          </p>
          <p>
            A search engine gives you a list. Supplier Discovery gives you an
            organised, sourced comparison against the criteria you wrote — including
            what could not be confirmed, and what to ask next.
          </p>
        </div>
      </div>

      <h3 class="queries__label">Questions buyers bring to us — examples</h3>
      <ul class="queries">
        {buyerQuestions.map((q) => (
          <li>
            <span class="queries__mark" aria-hidden="true">→</span>
            <span>{q}</span>
          </li>
        ))}
      </ul>
      <p class="queries__foot">
        None of these matches yours? Describe it anyway — the first reply is scoping,
        not selling. Today the desk is built around packaging; adjacent B2B categories
        are assessed case by case — <a class="text-link" href="/industries">see Industries →</a>
      </p>
    </div>
  </section>

  {/* 3 — What Supplier Discovery provides: the work, and its boundaries */}
  <section class="section section--grey" aria-labelledby="discovery-heading">
    <div class="wrap">
      <p class="eyebrow">The service</p>
      <h2 id="discovery-heading">What Supplier Discovery provides</h2>
      <p class="lede" style="max-width: 62ch;">
        A fixed-fee research project. You bring the brief; we do the desk work and
        hand back a report. It is deliberately narrow — and the boundaries are part
        of the offer, not fine print.
      </p>

      <div class="scope-grid">
        <div class="scope-panel">
          <h3>What the work covers</h3>
          <ul>
            <li>Structured desk research across public commercial sources — company sites, trade directories, published filings and product pages.</li>
            <li>A written criteria set built from your brief, agreed with you before research starts.</li>
            <li>Entries recorded with their source and research date — so every line can be checked.</li>
            <li>Preliminary Screening included — desk-based assessment of the available information, flagging obvious gaps and red flags.</li>
            <li>A fixed-fee, individually tailored quotation — scope and deliverables in writing before anything begins.</li>
          </ul>
        </div>
        <div class="scope-panel scope-panel--muted">
          <h3>What it does not cover</h3>
          <ul>
            <li>No verification, inspections, audits, product testing or quality assurance.</li>
            <li>No negotiation, purchasing authority or order placement — the decision stays with you.</li>
            <li>No guarantee of supplier availability, pricing, MOQs or outcomes.</li>
            <li>No supplier network access — every entry is found through your brief.</li>
            <li>No supplier contact or RFQ coordination — only where feasible, lawful and agreed in a separate written arrangement, never assumed.</li>
          </ul>
        </div>
      </div>
      <p class="scope-foot">
        The full service scope and exclusions are set out in
        <a href="/services">Services</a> and the <a href="/terms">Terms of Service</a>.
      </p>
    </div>
  </section>

  {/* 4 — Packaging: the initial industry focus, as structured rows */}
  <section class="section" aria-labelledby="packaging-heading">
    <div class="wrap">
      <div class="lede-row">
        <div>
          <p class="eyebrow">Initial industry focus</p>
          <h2 id="packaging-heading">Packaging, researched against real criteria.</h2>
        </div>
        <p class="lede" style="margin-bottom:0;">
          From the primary pack that touches the product to the corrugated outer that
          survives the journey. Each category is researched against the criteria that
          decide a fit — not a keyword search — and Packaging is where our research
          desk starts. Other industries are not yet researched depth areas; they are
          assessed case by case.
        </p>
      </div>
      <ol class="focus-rows">
        {focusRows.map((row) => (
          <li class="focus-row">
            <span class="focus-row__num" aria-hidden="true">{row.num}</span>
            <strong class="focus-row__category">{row.category}</strong>
            <span class="focus-row__detail">{row.detail}</span>
          </li>
        ))}
      </ol>
      <p style="margin:1.5rem 0 0;">
        <a class="text-link" href="/industries">How we research packaging requirements →</a>
      </p>
    </div>
  </section>

  {/* 5 — Q3: What information will the resulting report contain? */}
  <section class="section section--grey" aria-labelledby="report-heading">
    <div class="wrap">
      <p class="eyebrow">The deliverable</p>
      <h2 id="report-heading">What the report looks like</h2>
      <p class="lede" style="max-width: 64ch;">
        A structured document you can read, check and question — not a dashboard you
        have to interpret. Every Supplier Discovery report follows the same spine.
      </p>

      {/* The label must precede the sample: what follows is an illustration, not past work. */}
      <div class="report-exhibit" role="region" aria-label="Illustrative report structure">
        <div class="report-exhibit__bar">
          <span class="report-exhibit__tag">Illustrative report structure</span>
          <span class="report-exhibit__note">Example contents and entries — not a real report, not real suppliers, no real prices.</span>
        </div>

        <div class="report-exhibit__body">
          <ol class="report-doc">
            {reportContents.map((item) => (
              <li class="report-doc__row">
                <span class="report-doc__num" aria-hidden="true">{item.num}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="report-extract">
            <p class="report-extract__label">How one criterion travels through the report</p>
            <div class="criteria-table-wrap">
              <table class="criteria-table">
                <caption>Illustrative extract — one criterion, end to end</caption>
                <thead>
                  <tr>
                    <th scope="col">Criterion (as agreed)</th>
                    <th scope="col">What the report shows</th>
                    <th scope="col">Where it points you</th>
                  </tr>
                </thead>
                <tbody>
                  {criteriaRows.map((row) => (
                    <tr>
                      <th scope="row">{row.criterion}</th>
                      <td data-label="What the report shows">
                        <span class={`state state--${row.state}`}>{row.stateLabel}</span>
                        {row.shows}
                      </td>
                      <td data-label="Where it points you">{row.next}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="report-extract__close">
              That is how every criterion you set is handled: what is known, where it
              came from — and the question that takes you further.
            </p>
          </div>
        </div>
      </div>

      <div class="report-notes">
        <p>
          Supplier counts and outcomes are never guaranteed — the report reflects
          your brief and what public information actually shows. Some briefs support
          a shortlist; some support none, and we will say so rather than invent one.
        </p>
        <p>
          Preliminary Screening is desk-based research, not independent Supplier
          Verification — we do not visit facilities, audit suppliers or test products.
        </p>
      </div>

      <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center; margin-top:1.5rem;">
        <a class="btn btn--primary" href="/contact">Discuss your research needs</a>
        <a class="text-link" href="/services">See the full service in scope →</a>
      </div>
    </div>
  </section>

  {/* 6 — Q4: How a discussion becomes a report (dark) */}
  <section class="section section--dark on-dark" aria-labelledby="process-heading">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 id="process-heading">From your first email to a decision-ready report.</h2>
      <div class="steps">
        {processSteps.map((step) => (
          <div class="step">
            <span class="step__num" aria-hidden="true">{step.num}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
      <p style="margin-top:1.5rem; color: var(--text-muted-dark); font-size: 0.88rem; max-width: 62ch;">
        Emailing us never authorises a purchase, a supplier disclosure or an order —
        and it does not create an agreement. Scope, deliverables and fees are
        confirmed in writing first.{' '}
        <a class="text-link text-link--dark" href="/how-it-works">See each step in detail →</a>
      </p>
    </div>
  </section>

  {/* 7 — Who it is for */}
  <section class="section" aria-labelledby="audience-heading">
    <div class="wrap">
      <p class="eyebrow">Who it is for</p>
      <h2 id="audience-heading">Built for buyers with a genuine sourcing question.</h2>
      <p class="lede" style="max-width: 62ch;">
        Designed for businesses that need informed options before they spend their own
        time — not for consumers hunting retail bargains, and not a substitute for
        your own final due diligence.
      </p>
      <div class="fit-grid">
        <div class="fit-panel">
          <h3>A strong fit when…</h3>
          <ul>
            <li>You have a defined product or packaging requirement and need organised, sourced options</li>
            <li>You want criteria-based comparison rather than a raw supplier list</li>
            <li>You lack in-house research capacity, or want a second, independent read</li>
            <li>You are entering a new market or packaging category</li>
          </ul>
        </div>
        <div class="fit-panel fit-panel--muted">
          <h3>Probably not the right fit when…</h3>
          <ul>
            <li>You need facility audits, factory inspections, product testing or QA sign-off</li>
            <li>You need someone to negotiate, place orders or act as your purchasing authority</li>
            <li>You want payment protection, escrow or dispute resolution</li>
            <li>You want a ready-made supplier directory with instant guaranteed availability</li>
          </ul>
        </div>
      </div>
      <p class="audience-line">
        Typically: SMEs developing or refreshing packaging · importers and distributors
        adding suppliers · growing consumer brands scaling production · product
        developers sourcing components and packaging · sourcing and procurement
        businesses extending capacity.
      </p>
    </div>
  </section>

  {/* 8 — Final enquiry invitation */}
  <section class="section cta-band" aria-labelledby="cta-heading">
    <div class="wrap">
      <div>
        <h2 id="cta-heading">Have a sourcing question we can research?</h2>
        <p style="margin:0; max-width: 52ch;">
          Tell us what you need to source — a few sentences are enough to start. We
          will reply with questions, an honest feasibility view and, if it fits,
          a written scope and fixed-fee quotation.
        </p>
        <p style="margin:0.9rem 0 0; font-size:0.88rem;">
          Or email directly:{' '}
          <a class="mail" href="mailto:obsidixz.commercial@outlook.com">obsidixz.commercial@outlook.com</a>
        </p>
      </div>
      <a class="btn btn--on-dark" href="/contact" style="min-height:52px; padding-inline:1.75rem; font-size:1rem;">
        Discuss your research needs
      </a>
    </div>
  </section>
</BaseLayout>
